{
  "manifest_version": 3,
  "name": "Site Commenter",
  "short_name": "SiteComment",
  "version": "0.1.0",
  "description": "Замечания по интерфейсу: разметка, снимок и создание задачи в YouTrack",
  "minimum_chrome_version": "109",
  "permissions": [
    "activeTab",
    "identity",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Site Commenter — настройки",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "open-comments": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Открыть окно замечания"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://todo.example.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
