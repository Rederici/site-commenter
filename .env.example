# Значения по умолчанию, которые сборка вшивает в расширение.
# Скопируйте файл в .env и поставьте свои адреса.

# Инстанс YouTrack, куда уходят задачи.
SITECOMMENTER_YOUTRACK_URL=https://yt.example.com

# Домены, на которых попап работает по умолчанию (через запятую).
# Список можно менять в popup расширения без пересборки.
SITECOMMENTER_DEFAULT_SITES=todo.example.com
